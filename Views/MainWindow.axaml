<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CircleIntersectionApp.ViewModels"
        x:Class="CircleIntersectionApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CircleIntersectionApp"
        Width="1000" Height="700"
        MinWidth="840" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainWindowViewModel />
  </Window.DataContext>

  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#f4f4f4"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextBrush" Color="#222222"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#c92a2a"/>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#e0e0e0"/>
      <Setter Property="Foreground" Value="#222222"/>
      <Setter Property="BorderBrush" Value="#999999"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#ffffff"/>
      <Setter Property="Foreground" Value="#222222"/>
      <Setter Property="BorderBrush" Value="#999999"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource HeaderBrush}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
  </Window.Styles>

  <Grid Background="{StaticResource BackgroundBrush}" Margin="12" ColumnDefinitions="3*,4*" RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,12" Spacing="12">
      <TextBlock Text="CircleIntersectionApp" Classes="header" />
      <TextBlock Text="Простое окно ввода данных и визуализации пересечения окружностей" Classes="label" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12">
      <TextBlock Text="Входные данные" Classes="header"/>
      <TextBlock Text="Введите координаты и радиусы двух окружностей в две строки:" Classes="label"/>
      <TextBox Text="{Binding InputData, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" Watermark="x1 y1 r1\nx2 y2 r2"/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Command="{Binding LoadFileCommand}" CommandParameter="{Binding $parent[Window]}">Загрузить</Button>
        <Button Command="{Binding SaveFileCommand}" CommandParameter="{Binding $parent[Window]}">Сохранить</Button>
        <Button Command="{Binding ResetCommand}">Сброс</Button>
      </StackPanel>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10">
        <StackPanel Spacing="6">
          <TextBlock Text="Статус" FontWeight="Bold"/> 
          <TextBlock Text="{Binding StatusMessage}" Classes="label"/>
          <TextBlock Text="{Binding ErrorMessage}" Classes="label" Foreground="{StaticResource ErrorBrush}" IsVisible="{Binding HasErrorMessage}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Вывод результатов" Classes="header"/>
      <TextBox Text="{Binding OutputResult, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" MinHeight="200"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
      <TextBlock Text="Визуализация" Classes="header"/>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Text="Графическое представление окружностей" Classes="label"/>
          <ScrollViewer x:Name="GraphScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Canvas x:Name="GraphCanvas"
                Background="#ffffff"
                Height="520"
                ClipToBounds="True"
                SizeChanged="GraphCanvas_SizeChanged"
                PointerWheelChanged="GraphCanvas_PointerWheelChanged"
                PointerPressed="GraphCanvas_PointerPressed"
                PointerMoved="GraphCanvas_PointerMoved"
                PointerReleased="GraphCanvas_PointerReleased"/>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="ZoomInButton_Click">Увеличить</Button>
            <Button Click="ZoomOutButton_Click">Уменьшить</Button>
            <Button Click="ResetViewButton_Click">Сбросить вид</Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>